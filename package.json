{
  "name": "bitcoin-block-clock",
  "version": "1.1.4",
  "description": "Desktop Electron wrapper for Bitcoin Block Clock",
  "author": {
    "name": "patriceac",
    "email": "patriceac@users.noreply.github.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "electron": "electron .",
    "build:electron": "electron-builder",
    "build:electron:win": "electron-builder --win nsis portable --publish never",
    "build:electron:mac": "electron-builder --mac dmg --universal --publish never",
    "build:electron:linux": "electron-builder --linux AppImage deb --publish never",
    "pack:electron": "electron-builder --dir",
    "test": "node --test tests/*.test.js",
    "test:alerts": "node --test tests/price-alerts.test.js",
    "test:autoscan": "node --test tests/autoscan.test.js",
    "test:history": "node --test tests/history-feed.test.js"
  },
  "build": {
    "appId": "com.bitcoinblockclock.desktop",
    "productName": "Bitcoin Block Clock",
    "asar": false,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "app/src/main/assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/assets/bitcoin-logo.ico",
      "executableName": "BitcoinBlockClock",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "BitcoinBlockClock-Windows-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "BitcoinBlockClock-Windows-Portable.${ext}",
      "unpackDirName": "BitcoinBlockClock"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "BitcoinBlockClock-macOS.${ext}"
    },
    "linux": {
      "category": "Finance",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "BitcoinBlockClock-Linux.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  }
}
